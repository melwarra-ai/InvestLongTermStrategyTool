# AlphaStream Portfolio Manager - Secrets Template
# 
# INSTRUCTIONS:
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your actual credentials
# 3. NEVER commit secrets.toml to Git (it's in .gitignore)
#
# For Streamlit Cloud deployment:
# - Go to App Settings → Secrets
# - Paste this content with your real values

# ===== POSTGRESQL DATABASE =====
# Required for application data storage
[postgres]
host = "your-postgres-host.neon.tech"              # Example: "ep-cool-name-123456.us-east-2.aws.neon.tech"
dbname = "neondb"                                   # Default for Neon, or your database name
user = "your-username"                              # Your PostgreSQL username
password = "your-secure-password-here"              # Your PostgreSQL password (keep secret!)
port = "5432"                                       # Default PostgreSQL port

# ===== EXAMPLE PROVIDERS =====
# 
# Option A: Neon (Serverless PostgreSQL) - RECOMMENDED
# Sign up: https://neon.tech
# Free tier: 0.5 GB storage, 1M queries/month
# [postgres]
# host = "ep-cool-name-123456.us-east-2.aws.neon.tech"
# dbname = "neondb"
# user = "morris"
# password = "AbCdEf123456XyZ"
# port = "5432"
#
# Option B: Azure Database for PostgreSQL
# [postgres]
# host = "myserver.postgres.database.azure.com"
# dbname = "alphastream_prod"
# user = "myadmin@myserver"
# password = "YourSecurePassword123!"
# port = "5432"
#
# Option C: AWS RDS PostgreSQL
# [postgres]
# host = "mydb.abc123xyz.us-east-1.rds.amazonaws.com"
# dbname = "alphastream"
# user = "postgres"
# password = "YourSecurePassword123!"
# port = "5432"
#
# Option D: Supabase
# [postgres]
# host = "db.abcdefghijklmnop.supabase.co"
# dbname = "postgres"
# user = "postgres"
# password = "YourSupabasePassword123!"
# port = "5432"

# ===== OPTIONAL: EMAIL NOTIFICATIONS =====
# Uncomment and configure if you want email notifications
# [email]
# smtp_server = "smtp.gmail.com"
# smtp_port = "587"
# smtp_username = "your-email@gmail.com"
# smtp_password = "your-app-specific-password"
# from_name = "AlphaStream Portfolio"

# ===== SECURITY NOTES =====
# 
# 1. Never commit this file with real credentials
# 2. Use strong, unique passwords
# 3. Enable SSL/TLS for database connections (most providers default to this)
# 4. For Gmail SMTP, use App-Specific Passwords (not your main password)
# 5. Rotate passwords regularly
# 6. For production, consider using a secrets manager (AWS Secrets Manager, etc.)

# ===== TROUBLESHOOTING =====
#
# "could not connect to server" error:
# - Check host, port, and credentials are correct
# - Ensure database allows connections from your IP (or 0.0.0.0/0 for Streamlit Cloud)
# - Verify database is running
#
# "relation 'database_store' does not exist":
# - Table auto-creates on first run
# - If error persists, manually create table (see DEPLOYMENT.md)
#
# "No module named 'psycopg2'":
# - Add psycopg2-binary>=2.9.9 to requirements.txt
# - Redeploy app
