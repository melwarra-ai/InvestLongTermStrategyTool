# .streamlit/secrets.toml
# Configuration for InvestLongTermStrategyTool Database

# ⚠️ CRITICAL: This file contains sensitive credentials
# DO NOT commit this file to Git!
# Add to .gitignore: .streamlit/secrets.toml

[connections.gsheets]

# ==============================================================================
# STEP 1: ADD YOUR GOOGLE SHEET URL (REQUIRED!)
# ==============================================================================
# 1. Open your Google Sheet: "InvestLongTermStrategyTool Database"
# 2. Copy the FULL URL from your browser address bar
# 3. Paste it below (keep the quotes)
#
# Example:
# spreadsheet = "https://docs.google.com/spreadsheets/d/1AbC123XyZ456-LONG_ID_HERE/edit#gid=0"

spreadsheet = "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"


# ==============================================================================
# STEP 2: ADD SERVICE ACCOUNT CREDENTIALS
# ==============================================================================
# Open your downloaded JSON key file and copy the values below

type = "service_account"
project_id = "investlongtermstrategytool"

# From JSON: "private_key_id"
private_key_id = "paste_your_private_key_id_here"

# From JSON: "private_key"
# ⚠️ IMPORTANT: Include the ENTIRE key with BEGIN and END lines
# Keep all \n characters or line breaks
# Wrap in triple quotes """..."""
private_key = """-----BEGIN PRIVATE KEY-----
PASTE_YOUR_ENTIRE_PRIVATE_KEY_HERE
(it will be many lines long - paste ALL of them)
-----END PRIVATE KEY-----"""

# This should already be correct
client_email = "investlongtermstrategytool-ser@investlongtermstrategytool.iam.gserviceaccount.com"

# From JSON: "client_id"
client_id = "paste_your_client_id_here"

# These should stay as-is
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"

# From JSON: "client_x509_cert_url"
client_x509_cert_url = "paste_your_client_x509_cert_url_here"


# ==============================================================================
# CHECKLIST BEFORE SAVING:
# ==============================================================================
# [ ] spreadsheet URL is filled in
# [ ] private_key_id is filled in
# [ ] private_key includes BEGIN/END lines
# [ ] private_key is wrapped in triple quotes """
# [ ] client_id is filled in
# [ ] client_x509_cert_url is filled in
# [ ] No extra spaces before/after values
# [ ] This file is in .streamlit/secrets.toml
# [ ] This file is in .gitignore


# ==============================================================================
# TESTING:
# ==============================================================================
# After filling this in, test locally:
#   1. streamlit run app.py
#   2. Check sidebar: Should show "☁️ Google Sheets Database"
#   3. If errors, check:
#      - spreadsheet URL is complete (with https://)
#      - private_key has no extra spaces
#      - Google Sheet is shared with service account email
